#!/usr/bin/env node
// git pre-merge-commit — a merge that git commits by itself (a clean `git pull`,
// `git merge`) never runs pre-commit, so nothing checked the Transcript as it
// landed: on 2026-10-29 two such merges (d9bd8082, cc3b5320) each lost three
// remarks both of their parents held, and `dialogue.mjs check` passed afterwards.
// Before git writes the merge, every remark both parents hold must still be in
// it (dialogue-merge.mjs, mergeLosses); otherwise the merge stops uncommitted,
// as a conflict would, with each remark named. Only the Transcript is read, so
// it costs a few `git show`s. A copy with no dev/ holds no Transcript and passes.
//
// Then the generated pages: on 2026-11-04 a merge git committed by itself carried
// a chat's old one-file Agreements (1,035 lines) to main beside the new pages, and
// it was pushed before post-merge's rebuild reached a commit. So every page made
// from the Transcript is rebuilt here from the merged Transcript, with the merged
// code; if any changed they are staged and the merge stops uncommitted, since git
// writes a merge from the index as it stood before this hook. `git commit --no-edit`
// finishes it, through the commit gate.
// Switched on with the other git hooks by session-brief.mjs (core.hooksPath).

import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { execFileSync } from 'node:child_process';
import { pathToFileURL } from 'node:url';

const root = execFileSync('git', ['rev-parse', '--show-toplevel'], { encoding: 'utf8' }).trim();
const script = join(root, 'ux', 'scripts', 'dialogue-merge.mjs');
if (!existsSync(script)) process.exit(0);
const { mergeLosses } = await import(pathToFileURL(script).href);
// Only the merge under way: an older merge not yet pushed is the commit gate's (`dialogue.mjs check`).
const faults = mergeLosses({ gitRoot: root, root, since: 'HEAD' });
if (faults.length) {
  process.stderr.write(`\npre-merge-commit: merge stopped, uncommitted: it would lose Transcript remarks both sides hold:\n${faults.map((f) => `  - ${f}`).join('\n')}\n  Put each back, then git add and git commit.\n\n`);
  process.exit(1);
}

