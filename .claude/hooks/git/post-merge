#!/usr/bin/env node
// git post-merge — after a merge or pull that went through, every page generated
// from the Transcript is rebuilt from what was merged (T-768).
//
// The merge driver (dialogue.mjs merge-driver, .gitattributes) rebuilds each
// generated page both sides changed. Since the Agreements are kept in parts, a
// page can be new on one side only (a new group, a group's next part), and git
// takes that side's copy without asking the driver, still citing a number the
// merge may have moved. So the pages are rebuilt here, in the working tree, and
// the next commit carries them (the commit gate rebuilds and stages them too,
// git/pre-commit). It never stops or changes the merge itself, which is done.
// A copy with no dev/ holds no Transcript and does nothing.

import { existsSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { execFileSync, spawnSync } from 'node:child_process';
import { fileURLToPath } from 'node:url';

let root = '';
try {
  root = execFileSync('git', ['rev-parse', '--show-toplevel'], { encoding: 'utf8' }).trim();
} catch {
  process.exit(0);
}
const script = join(dirname(fileURLToPath(import.meta.url)), '..', '..', '..', 'ux', 'scripts', 'dialogue.mjs');
if (!existsSync(script) || !existsSync(join(root, 'dev', 'dialogue', 'transcript'))) process.exit(0);
// No GIT_* variable passed on: the rebuild runs git in the repository merged, by its own path.
const env = Object.fromEntries(Object.entries(process.env).filter(([k]) => !/^GIT_/i.test(k)));
spawnSync(process.execPath, [script, 'after-merge'], { cwd: root, env, stdio: 'inherit', timeout: 30000 });
process.exit(0);
