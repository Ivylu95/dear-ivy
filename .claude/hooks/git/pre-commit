#!/usr/bin/env node
// git pre-commit — the machine checks run on every commit, whoever makes it.
//
// SFG-007, "A rule a machine can check is checked on every change, whoever made
// it." The session hooks only see a session's own tool calls; an edit made from
// a laptop, a script or GitHub's editor reaches the repository past all of them.
// Every change passes a commit, so the gate is here too.
//
// Switched on by session-brief.mjs, which points core.hooksPath at this folder
// at every session start (git does not carry hook settings in a clone).
//
// NEVER blocks a commit that only touches the record (data/): the save hook
// commits her words every turn, and a gate that stopped that would lose what she
// said to protect a harness file. Such commits pass at once. data-sandbox/ is not
// the record: it is outside data/, and a commit touching it runs the privacy check
// (A-155, 2026-11-01; until then it passed here unread, with a real name in it).
// The save hook commits the sandbox apart from her record, so a refusal there
// never holds back her words.
//
// Every other commit is refused on a failing check, with one exception: the link
// check reports and lets the commit through, because it carries a backlog of old
// paths from the imported record that no single commit can clear. Move a check
// out of REPORT_ONLY the day it runs clean. There is no switch: the build/locked
// file that used to decide this was removed on the owner's instruction, 2026-09-27.

// The checks run against what the commit carries, never the working tree:
// several sessions share one tree, and one session's unfinished file must not
// refuse another session's commit (it did, 2026-09-27). The index is copied to
// a temporary folder, about a second, every check runs there, side by side
// (T-841, lib/side-by-side.mjs), and the folder is removed on the way out.

import { execFileSync, spawnSync } from 'node:child_process';
import { existsSync, mkdtempSync, rmSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
import { TOKEN } from '../lib/update/secrets.mjs';
import { lostRecordFiles } from '../lib/record-archive.mjs';
import { hazardEntryAdded, runRecordOnly } from '../lib/hazard-log.mjs';
import { DIALOGUE_CHECKS, GENERATED, carriedFromRefused, dialogueOnly, inSandbox, recordOnly, rememberRefused, stagedNames, unownedStaged } from '../lib/refused-staged.mjs';
import { touchedBy } from '../lib/touched.mjs';
import { waitTurn } from '../lib/gate-queue.mjs';
import { linkPackages } from '../lib/worktree-packages.mjs';
import { checksFor } from '../../../ux/lib/checks.mjs';
import { unsignedEnv } from '../lib/unsigned-git.mjs';
import { narrowable } from '../lib/affected.mjs';
import { runSideBySide } from '../lib/side-by-side.mjs';

const root = execFileSync('git', ['rev-parse', '--show-toplevel'], { encoding: 'utf8' }).trim();
// Raw names, never git's quoted form (lib/refused-staged.mjs, review 2026-10-16).
const staged = stagedNames(root);
// PRV-003: an access key never enters history, not even in the record. Checked
// before the record-only pass below: a key the save hook would commit is the
// one thing worth stopping a save for, since history keeps it after it expires.
const addedText = execFileSync('git', ['diff', '--cached', '-U0', '--no-color'], { cwd: root, encoding: 'utf8', maxBuffer: 64 * 1024 * 1024 })
  .split('\n')
  .filter((l) => l.startsWith('+') && !l.startsWith('+++'))
  .join('\n');
if (TOKEN.test(addedText)) {
  console.error('\n  pre-commit: refused. This commit adds an access key. Take it out and revoke it (PRV-003).\n');
  process.exit(1);
}
// GitHub refuses any file over 100 MiB on push, and once such a commit is made
// every save after it fails to push too: the gate accepted a 105 MB file into the
// record (round 3, D12). Refused over 95 MiB, record or not, before it is history;
// over 50 MiB, where GitHub starts to warn, it passes with a note.
{
  const MiB = 1024 * 1024;
  const added = execFileSync('git', ['-c', 'core.quotePath=false', 'diff', '--cached', '--raw', '-z', '--no-abbrev', '--diff-filter=AMCRT'], { cwd: root, encoding: 'utf8', maxBuffer: 64 * 1024 * 1024 }).split('\0');
  const blobs = [];
  for (let i = 0; i < added.length - 1; i += 1) {
    if (!added[i].startsWith(':')) continue;
    const [, , , sha, kind] = added[i].slice(1).split(' ');
    // A rename or copy names two paths; the second is where it lands.
    const path = /^[RC]/.test(kind) ? added[i + 2] : added[i + 1];
    if (!/^0+$/.test(sha)) blobs.push({ sha, path });
  }
  if (blobs.length) {
    const sizes = execFileSync('git', ['cat-file', '--batch-check=%(objectsize)'], { cwd: root, encoding: 'utf8', input: `${blobs.map((b) => b.sha).join('\n')}\n` }).split('\n');
    const sized = blobs.map((b, i) => ({ ...b, mib: Number(sizes[i]) / MiB }));
    const big = sized.filter((b) => b.mib > 95);
    const large = sized.filter((b) => b.mib > 50 && b.mib <= 95);
    const list = (bs) => bs.map((b) => `  ${b.path} (${b.mib.toFixed(0)} MiB)`).join('\n');
    if (big.length) {
      console.error(`\n  pre-commit: refused. GitHub refuses a file over 100 MiB, and once one is committed every later save fails to push:\n${list(big)}\n  Unstage it (git restore --staged -- <path>) and keep it outside the repository, or in data/archive-local/, which stays on this machine.\n`);
      process.exit(1);
    }
    if (large.length) process.stderr.write(`\npre-commit: note, a large file (GitHub warns over 50 MiB, refuses over 100):\n${list(large)}\n`);
  }
}
if (recordOnly(staged)) process.exit(0);

// The cards follow the Transcript in the same commit (T-631). They are generated
// from it, and the dialogue check refuses every commit while they differ: on
// 2026-11-02 one chat pushed a sorted remark without its rebuild, and every
// commit in every chat was refused until someone ran the build by hand. So every
// commit rebuilds them here (a third of a second) and takes in any that changed:
// not only one carrying a Transcript change, because a merge of two sides that
// each added a remark is committed by git without this gate and left the cards a
// remark short (313e0375, 3 Nov), and a merge hook cannot add to its commit
// (tried in a scratch repository); the next commit from any chat now repairs it
// (T-643). Only when the Transcript on disk is what is staged, so the build reads
// what the commit carries, and never inside a merge, which the merge driver
// rebuilds itself. A build that fails is left to the dialogue check below.
if (
  spawnSync('git', ['rev-parse', '-q', '--verify', 'MERGE_HEAD'], { cwd: root }).status !== 0 &&
  spawnSync('git', ['diff', '--quiet', '--', 'dev/dialogue/transcript/'], { cwd: root }).status === 0
) {
  const built = spawnSync(process.execPath, ['ux/scripts/dialogue.mjs', 'build'], { cwd: root, encoding: 'utf8' });
  // A commit that names its files leaves the main index stale for these; post-commit settles it.
  if (built.status === 0) spawnSync('git', ['add', '--', ...GENERATED], { cwd: root });
}

// A merge's conflict markers are never committed as its resolution: on 2026-10-20 a
// Transcript merge carrying <<<<<<< lines was committed in a scratch worktree and the
// dialogue check still read it as matching (caught by hand before the push). Any added
// line opening with seven < or > and then a space or its end, in any file but the
// record's: the record's saves are never stopped, and the save hook never stages a
// record file a stopped merge left in conflict (record/save-record.mjs).
{
  const markers = [];
  let file = null;
  for (const line of execFileSync('git', ['-c', 'core.quotePath=false', 'diff', '--cached', '-U0', '--no-color', '--no-ext-diff', '--diff-filter=AMCRT'], { cwd: root, encoding: 'utf8', maxBuffer: 64 * 1024 * 1024 }).split('\n')) {
    if (line.startsWith('+++ ')) file = line.replace(/^\+\+\+ (?:b\/)?/, '');
    else if (file && !/^data\//.test(file) && /^\+(?:<{7}|>{7})(?: |$)/.test(line) && !markers.includes(file)) markers.push(file);
  }
  if (markers.length) {
    process.stderr.write(`\npre-commit: commit refused — conflict markers (<<<<<<< or >>>>>>>) are staged as content:\n${markers.map((f) => `  ${f}`).join('\n')}\n  Settle the merge in each file, then stage it again.\n\n`);
    process.exit(1);
  }
}

// Files a refused commit left staged are refused once more, by name, so they
// ride into this commit only on purpose (lib/refused-staged.mjs).
const carried = carriedFromRefused(staged, root);
if (carried.length) {
  process.stderr.write(`\npre-commit: commit refused — a refused commit left these staged, and this one would carry them under its own message:\n${carried.map((f) => `  ${f}`).join('\n')}\n  Unstage them (git restore --staged -- <paths>), or run the same commit again to carry them on purpose.\n\n`);
  process.exit(1);
}

// Files another chat staged in this shared tree ride in under this commit's
// message only on purpose (lib/refused-staged.mjs, unownedStaged).
const unowned = unownedStaged(staged, {
  touched: touchedBy(process.env.CLAUDE_CODE_SESSION_ID),
  merging: spawnSync('git', ['rev-parse', '-q', '--verify', 'MERGE_HEAD'], { cwd: root }).status === 0,
  cwd: root,
});
if (unowned.length) {
  process.stderr.write(`\npre-commit: commit refused — this session never touched these staged files, so another chat may have staged them:\n${unowned.map((f) => `  ${f}`).join('\n')}\n  Commit your own by name (git commit -m "…" -- <your paths>), or run the same commit again to carry them on purpose.\n  Your own may be named here too: a file written by a script or a shell command, or staged in the same command as this commit, is not yet on this session's list (session/track-touched.mjs records it after the command). Check each is yours, then run the same commit again; next time edit with Edit or Write, and stage in a command of its own.\n\n`);
  process.exit(1);
}

const REPORT_ONLY = new Set();

// The checks are ux/lib/checks.mjs's, those marked `gate`: one list with
// `npm run check` and the push workflow, so the three cannot drift (SFG-007
// design 4; the gate and npm run check had drifted by about ten checks,
// design audit 2026-10-08). Each entry's `limitMs` is its time limit here, a
// minute unless given: the selftest's is about two and a half times its
// slowest whole run (91s, 2026-10-04).
// A commit carrying only FEEDBACK.md, with or without the record, is the save
// hook keeping a lesson (CON-017): it runs the checks that read that file, the
// privacy check's stricter tier and the secrets check, so the save finishes
// inside its turn-end time. Every check above this point still ran.
// A commit of the sandbox (data-sandbox/), with or without the record or a lesson,
// is the save hook keeping a test chat: the same two checks, so a name typed into
// the sandbox is refused there (A-155) and the save still ends inside its turn.
const LESSON_CHECKS = new Set(['privacy', 'secrets']);
const lessonOnly = staged.some((f) => f === 'FEEDBACK.md' || inSandbox(f)) && staged.every((f) => f === 'FEEDBACK.md' || inSandbox(f) || recordOnly([f]));
// A-164 ("I don't wait on the machinery"): a commit of only the dialogue runs the
// checks that read it, in seconds instead of minutes; the full set still runs on
// every other commit, on the daily safeguard run and before any release.
const CHECKS = lessonOnly ? checksFor('gate').filter((c) => LESSON_CHECKS.has(c.name))
  : dialogueOnly(staged) ? checksFor('gate').filter((c) => DIALOGUE_CHECKS.has(c.name))
  : checksFor('gate');

const failed = [];
const reported = [];

// SFG-010 at the commit itself: a safety-surface file in this commit needs the
// hazard log in the same commit. The end-of-turn gate alone let a crisis-block
// change be committed mid-turn before its entry was written (hazard log,
// 2026-09-26). Keep this list in step with SURFACE in hooks/safety/safety-at-stop.mjs.
const SURFACE = [
  'CLAUDE.md',
  'AGENTS.md',
  '.claude/hooks/safety/',
  '.claude/skills/first-contact/',
  '.claude/jobs/check-in.md',
  'dev/specs/interaction/safety.md',
  'ux/lib/safety.mjs',
  'ux/scripts/check-safety.mjs',
];
// A job file whose only change is its run record (when it ran, who ran it) is not a
// change to what the run is told; the record is rewritten on every claim and finish.
const blobOf = (spec) => spawnSync('git', ['show', spec], { cwd: root, encoding: 'utf8' }).stdout ?? '';
const recordChangeOnly = (f) => f.startsWith('.claude/jobs/') && runRecordOnly(blobOf(`HEAD:${f}`), blobOf(`:${f}`));
const touched = staged.filter((f) => SURFACE.some((s) => (s.endsWith('/') ? f.startsWith(s) : f === s)) && !recordChangeOnly(f));
if (touched.length && !staged.includes('policies/SAFETY_POLICY.md')) {
  failed.push(
    `── safety gate (SFG-010) ──\nThis commit changes the safety surface without a hazard-log entry in policies/SAFETY_POLICY.md:\n${touched.map((f) => `  - ${f}`).join('\n')}\nAdd the entry and stage it in the same commit.`,
  );
} else if (touched.length) {
  // Staged is not enough: the entry has to be a new dated row inside "## The
  // hazard log". On 2026-10-05 three entries landed in the results table above
  // it and passed here (lib/hazard-log.mjs).
  const blob = (spec) => spawnSync('git', ['show', spec], { cwd: root, encoding: 'utf8' }).stdout ?? '';
  if (!hazardEntryAdded(blob('HEAD:policies/SAFETY_POLICY.md'), blob(':policies/SAFETY_POLICY.md'))) {
    failed.push(
      `── safety gate (SFG-010) ──\nThis commit changes the safety surface, and policies/SAFETY_POLICY.md is staged, but "## The hazard log" gains no new dated row:\n${touched.map((f) => `  - ${f}`).join('\n')}\nPut the entry in the hazard log itself, newest first, not in another table of the file.`,
    );
  }
}

// SFG-007's second check: a record file that leaves data/ in a harness commit
// reappears under data/archive/ in the same commit. A move shows as a rename and
// passes; only an outright deletion is looked at. Record-only commits returned
// above, because the save hook must never be stopped — a deletion there is
// guard-record-deletion.mjs's to refuse before it happens, and history keeps it.
// Unquoted names, for the same reason as `staged` above.
const status = execFileSync('git', ['-c', 'core.quotePath=false', 'diff', '--cached', '--name-status', '-M', '--diff-filter=AD'], { cwd: root, encoding: 'utf8' })
  .split('\n')
  .filter(Boolean)
  .map((l) => l.split('\t'));
// In a merge, a file the incoming side had already removed is that side's
// deletion; only a file it still holds is this commit's to account for.
const merging = spawnSync('git', ['rev-parse', '-q', '--verify', 'MERGE_HEAD'], { cwd: root }).status === 0;
const incoming = merging ? (f) => spawnSync('git', ['cat-file', '-e', `MERGE_HEAD:${f}`], { cwd: root }).status === 0 : null;
const lost = lostRecordFiles(status, incoming);
if (lost.length) {
  failed.push(`── record archive (SFG-007) ──\nThese leave the record without an archived copy in this commit:\n${lost.map(([, f]) => `  - ${f}`).join('\n')}\nMove them under data/archive/ with git mv instead.`);
}

// The full gate waits its turn, one at a time on the machine (lib/gate-queue.mjs):
// the sweep's jobs ran it side by side and timed out (2026-11-03). A lesson or a
// Transcript-only commit runs a few quick checks and does not queue.
const fullGate = !lessonOnly && !dialogueOnly(staged);
const turn = fullGate ? waitTurn() : { release: () => {}, waitedMs: 0, wentAhead: false };
if (turn.waitedMs > 5000) process.stderr.write(`pre-commit: waited ${Math.round(turn.waitedMs / 1000)} s for another commit's checks to finish${turn.wentAhead ? ', then went ahead' : ''}\n`);
// The checks find their packages through DEAR_GIT_ROOT; a worktree with none
// borrows the main checkout's (lib/worktree-packages.mjs, 2026-11-04).
if (fullGate && linkPackages(root)) process.stderr.write('pre-commit: linked ux/node_modules to the main checkout\'s, so the checks find their packages\n');
const snapshot = mkdtempSync(join(tmpdir(), 'dear-pre-commit-'));
try {
  // autocrlf off: on Windows the snapshot would otherwise be written with CRLF,
  // and a check that compares text exactly (the profile template) fails on it.
  execFileSync('git', ['-c', 'core.autocrlf=false', 'checkout-index', '--all', `--prefix=${snapshot}/`], { cwd: root });
  // T-841: the checks run side by side, those marked `alone` after them with nothing
  // beside (lib/side-by-side.mjs), then are read here in the list's order, each
  // exactly as it was when they ran one after another.
  const slots = [];
  const jobs = [];
  for (const { name, script, args = [], cwd = 'ux', limitMs = 60000, alone = false } of CHECKS) {
    // This file runs from the working tree, so a check another session has listed
    // here before committing its script would refuse every commit. A check whose
    // script is not in this commit belongs to a change not yet made: report it.
    // One already committed and missing here is being removed, so it fails
    // (SFG-014): deleting a check is not a way past it.
    if (!existsSync(join(snapshot, script))) {
      const committed = spawnSync('git', ['cat-file', '-e', `HEAD:${script}`], { cwd: root }).status === 0;
      // A copy with no dev/ (one made for someone else, DEP-013) never holds the
      // development checks: nothing to report, where "failing" read as a fault at
      // every commit of every such copy (set-up cases, rehearsal 2026-10-27).
      if (!committed && script.startsWith('dev/') && !existsSync(join(snapshot, 'dev'))) continue;
      slots.push({ settled: () => (committed ? failed : reported).push(`── ${name} ──\n${script} ${committed ? 'is removed by this commit' : 'is not in this commit yet'}`) });
      continue;
    }
    // DEAR_GIT_ROOT: the snapshot has no .git; the selftest reads file modes
    // from the real index, which is what this commit carries. No GIT_* variable
    // is passed on: in `git commit -- <path>` they name this repository, and a
    // check that runs git in a scratch repository then commits, deletes
    // branches and pushes here instead (2026-10-03: main was emptied on GitHub).
    // The one reader that wants the index gets it as DEAR_GIT_INDEX.
    const { GIT_INDEX_FILE } = process.env;
    const env = Object.fromEntries(Object.entries(process.env).filter(([k]) => !/^GIT_/i.test(k)));
    jobs.push({
      file: process.execPath,
      args: [join(snapshot, script), ...args],
      cwd: join(snapshot, cwd),
      // A-164: a commit of only code outside safety and privacy runs the selftest's
      // cases that reach what it changed (lib/affected.mjs); the rest of the checks
      // run whole, and the full selftest runs daily and on every release.
      // Unsigned: the checks' throwaway commits skip the machine's signer (lib/unsigned-git.mjs).
      env: unsignedEnv({ ...env, CLAUDE_PROJECT_DIR: snapshot, DEAR_GIT_ROOT: root, ...(GIT_INDEX_FILE && { DEAR_GIT_INDEX: GIT_INDEX_FILE }), ...(name === 'hooks selftest' && narrowable(staged) && { DEAR_SELFTEST_STAGED: staged.join('\n') }) }),
      // The selftest runs ~90 cases, several of them whole scratch repositories,
      // and took 91s on this machine on 2026-10-04: at 60s it was killed part
      // way and read as a failure, refusing commits whose every case passed.
      // It gets its own, longer limit; every other check keeps the minute.
      timeout: limitMs,
      alone,
    });
    const job = jobs.length - 1;
    slots.push({ settled: (runs) => {
      const run = runs[job];
      // Killed for time is not the same as failed, and says so: the old report
      // showed stderr only, so a timeout read as an empty failure.
      if (run.error?.code === 'ETIMEDOUT' || run.signal) {
        failed.push(`── ${name} ──\ndid not finish within ${Math.round(limitMs / 1000)}s (killed, not failed); run it by hand to see whether it passes`);
        return;
      }
      // The selftest prints a line per case; only the failing ones are news.
      // Both streams: a case writing a line to stderr hid every failing line on
      // stdout, because only the first non-empty stream was shown.
      const out = [run.stderr, run.stdout].filter(Boolean).join('\n').trim() || 'did not finish';
      const shown = name === 'hooks selftest' ? out.split('\n').filter((l) => !/^\s*ok\b/.test(l)).join('\n').trim() : out;
      if (run.status !== 0) (REPORT_ONLY.has(name) ? reported : failed).push(`── ${name} ──\n${shown}`);
    } });
  }
  const runs = await runSideBySide(jobs);
  for (const slot of slots) slot.settled(runs);
} finally {
  turn.release();
  rmSync(snapshot, { recursive: true, force: true });
}
if (reported.length) {
  // A count, not the list: the link backlog runs to hundreds of lines.
  process.stderr.write(`\npre-commit: reported, not blocking — ${reported.map((r) => r.split('\n')[0]).join(', ')} failing. Run the check to see it.\n`);
}
if (!failed.length) process.exit(0);

// A refused commit leaves its files staged, and the next commit takes them in
// under its own message: twice (2026-09-30, 2026-10-03), the second time with
// the rule already written in the commit skill. So the refusal names them.
let stillStaged = '';
try {
  stillStaged = execFileSync('git', ['diff', '--cached', '--name-only'], { encoding: 'utf8' }).trim();
} catch {}
const left = stillStaged
  ? `Still staged, and the next commit will carry them unless you unstage first:\n${stillStaged.split('\n').map((f) => `  ${f}`).join('\n')}\n  git restore --staged -- <paths>\n\n`
  : '';
process.stderr.write(`\npre-commit: commit refused, ${failed.length} check(s) failed\n\n${failed.join('\n\n')}\n\n${left}`);
rememberRefused(root);
process.exit(1);
