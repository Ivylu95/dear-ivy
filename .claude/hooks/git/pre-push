#!/usr/bin/env node
// git pre-push — nothing is pushed from a harness checkout anywhere but its own
// origin, and never to the release repository.
//
// The release repository receives releases only from the release workflow,
// which builds each one from the manifest in a fresh folder with no hooks. A
// push to it from a checkout like this one can only be a mistake, and the worst
// one there is: this checkout holds a record (data/) and the design (dev/specs/),
// and the release repository is read by every person's copy. The mistake has a
// known way in: when the development repository was renamed and a new release
// repository took its old name, a chat or clone still using the old address
// would push here. So the push is refused, whatever it carries.
//
// The release repository's address is the one pinned for this copy: in the record,
// data/core/setup/release-source.json, or for a copy pinned before the address moved
// there, .claude/release/source.json (lib/release-source.mjs).
// Switched on with the other git hooks by session-brief.mjs (core.hooksPath).
// Falls short for a clone made before this hook existed and never pulled since:
// that is why every chat on the old address is closed before a new repository
// takes its name.

import { join, resolve } from 'node:path';
import { pathToFileURL } from 'node:url';
import { execFileSync } from 'node:child_process';
import { readFileSync } from 'node:fs';

const [, , remoteName = '', remoteUrl = ''] = process.argv;
const root = execFileSync('git', ['rev-parse', '--show-toplevel'], { encoding: 'utf8' }).trim();

/** owner/name for a GitHub address in any of its forms, else the path itself. */
// The host is anchored (round 2, 2026-10-29, C3): `https://evil.example/github.com/…`
// and `file:///srv/github.com/…` once read as GitHub addresses, and a push to one landed.
export function repoKey(url) {
  const s = String(url).trim().replace(/\/+$/, '').replace(/\.git$/i, '');
  const gh = s.match(/^(?:[a-z+]+:\/\/)?(?:[^@/]+@)?(?:www\.)?github\.com[:/]([^/]+)\/([^/]+)$/i);
  if (gh) return `github:${gh[1]}/${gh[2]}`.toLowerCase();
  return `path:${resolve(s.replace(/^file:\/\//i, ''))}`;
}

// Anywhere but origin is refused too (edge cases, 2026-10-29, D-G7): a copy has
// one home, its own repository on GitHub, and a push elsewhere (a remote a pasted
// line added, an address typed in full) would carry the record out of it. A push
// to origin's own address in another form, a key in it or not, is origin.
// Origin is its fetch address, not its push address: a pushurl or a pushInsteadOf
// line sends origin's pushes elsewhere, and the push address agreed with it (C3).
let origins = [];
try {
  origins = execFileSync('git', ['remote', 'get-url', '--all', 'origin'], { cwd: root, encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] })
    .split('\n')
    .map((u) => u.trim())
    .filter(Boolean);
} catch {
  // No origin: nothing is home yet, so nowhere is.
}
if (!origins.some((u) => repoKey(u) === repoKey(remoteUrl))) {
  console.error(
    `\n  pre-push: refused. ${remoteName && remoteName !== remoteUrl ? `${remoteName} is` : 'that address is'} not this copy's origin.\n` +
      '  A copy pushes only to its own repository, the one named origin. If that\n' +
      '  repository moved, point origin at it: git remote set-url origin <its address>.\n',
  );
  process.exit(1);
}

// A merge pushed to main keeps both of its sides (2026-11-03: f5041f36 committed its first
// parent's files and lost the second's Transcript entries, a script fix, its test and more).
// Each merge the push adds is made again from its parents (lib/merge-sides.mjs); one that
// holds a parent's version of a file whole while the other parent changed it is refused,
// naming the merge and the paths, never their content. Tested by git/test-merge-sides.mjs.
let pushes = [];
try {
  pushes = readFileSync(0, 'utf8').split('\n').map((l) => l.trim().split(/\s+/)).filter((f) => f.length === 4);
} catch {}
const toMain = pushes.filter(([, , remoteRef]) => remoteRef === 'refs/heads/main');
if (toMain.length) {
  let sides = null;
  try {
    sides = await import(pathToFileURL(join(root, '.claude', 'hooks', 'lib', 'merge-sides.mjs')).href);
  } catch {
    // A checkout from before the check: nothing to run it with.
  }
  // A check that cannot run lets the push through, said: a save stopped by a broken
  // check is lost with the machine, which is worse than a merge read late.
  let found = [];
  try {
    found = sides ? toMain.flatMap(([, localSha, , remoteSha]) => sides.checkPush(root, localSha, remoteSha)) : [];
  } catch (error) {
    console.error(`\n  pre-push: the merge check could not run (${error.message}); pushing unchecked.\n`);
  }
  if (found.length) {
    console.error(
      '\n  pre-push: refused. A merge being pushed to main kept one side of a file whole and\n' +
        "  dropped the other side's changes to it:\n" +
        `${sides.describe(found)}\n` +
        "  Put the lost side back in a new commit on top (never by rewriting history): for each\n" +
        "  path, merge the dropped parent's change into the file as it is now, keeping both\n" +
        '  sides (git show <merge>^1:<path>, <merge>^2:<path> and their merge base; git merge-file\n' +
        '  does it), then commit and push again. Generated files: rebuild them. If one side was\n' +
        '  kept on purpose (both sides made the same change), say so in the message of a commit\n' +
        '  pushed with it (an empty one will do), one line a path: Kept one side: <path>\n' +
        "  That line is believed only where the dropped side's change is already in the kept\n" +
        "  version; it can't excuse a real loss.\n",
    );
    process.exit(1);
  }

  // A push to main that changes the harness leaves main whole (lib/push-whole.mjs, T-981):
  // the links, sandbox and sample checks pass on the pushed tree. Her record alone is never held.
  let whole = null;
  try {
    whole = await import(pathToFileURL(join(root, '.claude', 'hooks', 'lib', 'push-whole.mjs')).href);
  } catch {
    // A checkout from before the check.
  }
  if (whole) {
    for (const [, localSha, , remoteSha] of toMain) {
      let paths = [];
      try {
        paths = whole.pushedPaths(root, localSha, remoteSha);
      } catch (error) {
        console.error(`\n  pre-push: the whole-tree check could not read the push (${error.message}); pushing unchecked.\n`);
        continue;
      }
      if (!whole.touchesHarness(paths)) continue;
      const why = whole.cannotJudge(root, localSha);
      if (why) {
        console.error(`\n  pre-push: the whole-tree check did not run: ${why}; pushing unchecked.\n`);
        continue;
      }
      const { failed, skipped } = whole.runWhole(root);
      if (skipped.length) console.error(`\n  pre-push: could not run ${skipped.join(', ')}; pushing without ${skipped.length > 1 ? 'them' : 'it'}.\n`);
      if (failed.length) {
        console.error(
          '\n  pre-push: refused. Pushed to main, this would leave main failing its own checks, so\n' +
            "  every other chat's saves would stall behind it (T-981):\n" +
            failed.map((f) => `  ── ${f.name} ──\n${f.out.replace(/^/gm, '    ')}`).join('\n') +
            '\n  Finish the change first (push the file a pointer names, move what the move left behind),\n' +
            '  or, if another chat broke main, pull its fix; then push again. Never loosen the check.\n',
        );
        process.exit(1);
      }
    }
  }
}

let release = '';
try {
  const { releaseRepo } = await import(pathToFileURL(join(root, '.claude', 'hooks', 'lib', 'release-source.mjs')).href);
  release = releaseRepo(root);
} catch {
  process.exit(0);
}
if (!release) process.exit(0);

if (repoKey(remoteUrl) === repoKey(release)) {
  console.error(
    `\n  pre-push: refused. ${remoteName || remoteUrl} is the release repository.\n` +
      '  Releases reach it only through the release workflow, never from a checkout\n' +
      '  that holds a record and the specs. If this checkout still uses an old\n' +
      "  address, point it at the development repository: git remote set-url origin <its address>.\n",
  );
  process.exit(1);
}
